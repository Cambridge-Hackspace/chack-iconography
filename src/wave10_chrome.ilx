      path d="M12,15 v6 M12,21 l3,-3 M6,3 l3,3" stroke="ink" width=1.4
    }
  }
}

icon "chrome-detail-bubble" {
  category "chrome"
  canvas 24 24
  describe "Detail reference bubble with a leader."
  part "g" {
    at 0 0 0 {
