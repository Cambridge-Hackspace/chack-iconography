      path d="M14,7 v6 M11,10 h6" stroke="ink-muted" width=1.2 dash="1.5 1.5"
      path d="M9,15 l-5,6" stroke="ink" width=1.4
    }
  }
}

icon "chrome-grid-ref" {
  category "chrome"
