    }
  }
}

icon "chrome-status-legend" {
  category "chrome"
  canvas 24 24
  describe "Status key: stacked state dots with labels."
  part "g" {
    at 0 0 0 {
      circle 6 7 1.8 fill="ink" stroke="none"
      circle 6 12 1.8 fill="none" stroke="ink" width=1.4
      circle 6 17 1.8 fill="ink-muted" stroke="none"
      path d="M10,7 h11 M10,12 h9 M10,17 h11" stroke="ink-muted" width=1.4
    }
  }
}
