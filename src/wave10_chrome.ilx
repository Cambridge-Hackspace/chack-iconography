// Wave 10 — diagram chrome. Annotation and layout marks, flat 24x24
// like the state badges (they live in screen space, not the iso grid).
// Numbered sequence markers reuse the existing badge-number-1..9 set.
// New "chrome" category.

icon "chrome-callout" {
  category "chrome"
  canvas 24 24
  describe "Callout box with a leader line."
  part "g" {
    at 0 0 0 {
      rect 3 3 18 11 rx=1.5 fill="none" stroke="ink" width=1.4
      path d="M6,7 h12 M6,10 h8" stroke="ink-muted" width=1.2
      path d="M9,14 l-2,7" stroke="ink" width=1.4
    }
  }
}

icon "chrome-callout-round" {
  category "chrome"
  canvas 24 24
  describe "Rounded speech callout."
  part "g" {
    at 0 0 0 {
      path d="M3,4 h18 v11 h-9 l-4,5 v-5 h-5 z" stroke="ink" width=1.4 fill="none"
      path d="M7,8 h10 M7,11 h6" stroke="ink-muted" width=1.2
    }
  }
}

icon "chrome-flag-note" {
  category "chrome"
  canvas 24 24
  describe "Flag annotation marker."
  part "g" {
    at 0 0 0 {
      path d="M6,3 v18" stroke="ink" width=1.5
      path d="M6,4 h13 l-3,4 3,4 h-13 z" stroke="ink" width=1.4 fill="none"
    }
  }
}

icon "chrome-annotation-pin" {
  category "chrome"
  canvas 24 24
  describe "Map-style location pin."
  part "g" {
    at 0 0 0 {
      path d="M12,21 c-6,-8 -6,-11 -6,-13 a6,6 0 0 1 12,0 c0,2 0,5 -6,13 z" stroke="ink" width=1.4 fill="none"
      circle 12 8 2.4 fill="ink" stroke="none"
    }
  }
}

icon "chrome-revision-cloud" {
  category "chrome"
  canvas 24 24
  describe "Revision cloud marking a changed area."
  part "g" {
    at 0 0 0 {
      path d="M5,14 a3,3 0 0 1 1,-6 a4,4 0 0 1 7,-2 a3,3 0 0 1 5,2 a3,3 0 0 1 2,5 a3,3 0 0 1 -3,4 a4,4 0 0 1 -6,1 a3,3 0 0 1 -6,-1 a3,3 0 0 1 -1,-3 z" stroke="ink" width=1.4 fill="none"
    }
  }
}

icon "chrome-section-marker" {
  category "chrome"
  canvas 24 24
  describe "Section cut marker."
  part "g" {
    at 0 0 0 {
