icon "badge-ip-tag" {
  category "badge"
  canvas 24 24
  describe "Small blank label plate."
  part "g" {
    at 0 0 0 {
      rect 2.5 8 19 8.5 rx=1.5 fill="none" stroke="ink" width=1.5
      circle 6 12.2 1.4 fill="none" stroke="ink" width=1.4
    }
  }
}

icon "badge-pin" {
  category "badge"
  canvas 24 24
  describe "Map pin."
  part "g" {
    at 0 0 0 {
      path d="M12,22 c-5,-7 -7,-9.5 -7,-13 a7,7 0 1 1 14,0 c0,3.5 -2,6 -7,13 z" stroke="outline" width=1.2 fill="ink"
      circle 12 9 2.8 fill="bg-canvas" stroke="none"
    }
  }
